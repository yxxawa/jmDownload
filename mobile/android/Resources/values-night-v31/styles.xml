<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@drawable/brand_launch_background</item>
    <item name="android:colorBackground">@color/dark_background</item>
    <item name="android:statusBarColor">@color/dark_status_bar</item>
    <item name="android:navigationBarColor">@color/dark_navigation_bar</item>
    <item name="android:windowSplashScreenBackground">@color/brand_launch_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
    <item name="android:windowSplashScreenAnimationDuration">180</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:colorAccent">#F7A51A</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
</resources>

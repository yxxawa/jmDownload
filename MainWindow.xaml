<Window x:Class="DesktopShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JM Download"
        Width="1420" Height="900"
        MinWidth="960" MinHeight="640"
        Background="#F3F5F2"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <Style x:Key="RetryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#286A4B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#347A5B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>

        <Border x:Name="StartupPanel" Background="#F3F5F2">
            <Grid>
                <Ellipse Width="520" Height="520"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-300,-170,0" Fill="#1A75B58F">
                    <Ellipse.Effect><BlurEffect Radius="72"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="420" Height="420"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-150,0,0,-280" Fill="#12C39B58">
                    <Ellipse.Effect><BlurEffect Radius="72"/></Ellipse.Effect>
                </Ellipse>

                <Border x:Name="StartupCard"
                        Width="486" Padding="34,32,34,28"
                        CornerRadius="22"
                        Background="#F8FFFFFF"
                        BorderBrush="#1B26392F"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="38" ShadowDepth="12" Opacity="0.12" Color="#17211C"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform Y="12"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.42"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="12" To="0" Duration="0:0:0.42"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="16" Background="#286A4B">
                                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.22" Color="#286A4B"/></Border.Effect>
                                <Grid>
                                    <Ellipse Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-14" Stroke="#35FFFFFF"/>
                                    <TextBlock Text="J" Foreground="White" FontFamily="Georgia" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,3,0,0">
                                <TextBlock Text="JM Download" FontSize="20" FontWeight="SemiBold" Foreground="#17211C"/>
                                <TextBlock Text="正在准备你的下载工作区" Margin="0,4,0,0" FontSize="12" Foreground="#78857D"/>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,29,0,0" Padding="17,15" CornerRadius="13" Background="#F0F5F1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="StartupProgress" Width="23" Height="23" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.05"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Ellipse Stroke="#D5E2DA" StrokeThickness="2.5"/>
                                    <Path Stroke="#347A5B" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 11.5,1.5 A 10,10 0 0 1 21.5,11.5"/>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="StatusText"
                                               Text="正在启动 C# 原生后端..."
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#26372E" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailText"
                                               Margin="0,4,0,0"
                                               MaxHeight="74"
                                               FontSize="11" LineHeight="17"
                                               Foreground="#7B8880"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,19,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#3A8A65"/>
                                <TextBlock Text="本地服务" Margin="7,0,0,0" FontSize="10" Foreground="#829087"/>
                                <Ellipse Width="3" Height="3" Fill="#BCC5BF" Margin="10,0"/>
                                <TextBlock Text="安全连接" FontSize="10" Foreground="#829087"/>
                                <Ellipse Width="3" Height="3" Fill="#BCC5BF" Margin="10,0"/>
                                <TextBlock Text="设置自动保存" FontSize="10" Foreground="#829087"/>
                            </StackPanel>
                            <Button x:Name="RetryButton"
                                    Content="重新尝试"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Style="{StaticResource RetryButtonStyle}"
                                    Click="RetryButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="JM Download · Native desktop experience"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,24" FontSize="10" Foreground="#9AA59E"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="DesktopShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JMComic 下载器"
        Width="1280" Height="860"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>

        <Border x:Name="StartupPanel">
            <Grid>
                <Border Width="460" Padding="28"
                        CornerRadius="10"
                        Background="White"
                        BorderBrush="#D9DEE8"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="JMComic 下载器"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="#1F2937"/>
                        <TextBlock x:Name="StatusText"
                                   Text="正在启动 C# 原生后端..."
                                   Margin="0,14,0,0"
                                   FontSize="14"
                                   Foreground="#667085"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="StartupProgress"
                                     Margin="0,22,0,0"
                                     Height="4"
                                     IsIndeterminate="True"/>
                        <ScrollViewer Margin="0,16,0,0"
                                      MaxHeight="160"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailText"
                                       FontSize="12"
                                       Foreground="#667085"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <Button x:Name="RetryButton"
                                Content="重试"
                                Width="92" Height="34"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Click="RetryButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

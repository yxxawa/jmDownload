<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SmokeTest Condition="'$(SmokeTest)' == ''">false</SmokeTest>
    <OutputType Condition="'$(SmokeTest)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(SmokeTest)' != 'true'">WinExe</OutputType>
    <StartupObject Condition="'$(SmokeTest)' == 'true'">DesktopShell.NativeBackendSmoke</StartupObject>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <AllowedOutputExtensionsInSingleFileSelfExtract>.dll;.exe;.json;.config;.pdb;.xml</AllowedOutputExtensionsInSingleFileSelfExtract>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(SmokeTest)' != 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(SmokeTest)' != 'true'">
    <Compile Remove="NativeBackendSmoke.cs" />
  </ItemGroup>

  <!--
    mobile/ 是独立的手机端工程，不属于桌面端编译范围。
    SDK 默认的 **/*.cs 通配符会把它一起编进来，而
    mobile/android/Backend/ 下的 ArtifactTools、JmImageDecoder
    与 NativeBackend/ 下的同名类同命名空间，会触发 CS0111 重复定义。
  -->
  <ItemGroup>
    <Compile Remove="mobile\**" />
    <EmbeddedResource Remove="mobile\**" />
    <None Remove="mobile\**" />
    <Page Remove="mobile\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="docs\THIRD_PARTY_NOTICES.txt" LogicalName="THIRD_PARTY_NOTICES.txt" />
    <EmbeddedResource Include="frontend\**\*.*"
                      LogicalName="frontend/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RemoveXmlDocsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedXmlDocs Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(PublishedXmlDocs)" />
  </Target>

  <!--
    WebView2 Evergreen Runtime is supplied by Windows and stays outside the
    single-file package. Only the small SDK bridge/loader required by the WPF
    host is published with the application.
  -->
  <Target Name="ExcludeWebView2BrowserRuntime" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <WebView2BrowserRuntime Include="@(ResolvedFileToPublish)"
                              Condition="'%(ResolvedFileToPublish.Filename)' == 'msedgewebview2'
                                      Or '%(ResolvedFileToPublish.Filename)' == 'EmbeddedBrowserWebView'
                                      Or '%(ResolvedFileToPublish.Filename)' == 'msedge'
                                      Or '%(ResolvedFileToPublish.Filename)' == 'msedge_elf'" />
      <ResolvedFileToPublish Remove="@(WebView2BrowserRuntime)" />
    </ItemGroup>
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SmokeTest Condition="'$(SmokeTest)' == ''">false</SmokeTest>
    <OutputType Condition="'$(SmokeTest)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(SmokeTest)' != 'true'">WinExe</OutputType>
    <StartupObject Condition="'$(SmokeTest)' == 'true'">DesktopShell.NativeBackendSmoke</StartupObject>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.1.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <AllowedOutputExtensionsInSingleFileSelfExtract>.dll;.exe;.json;.config;.pdb;.xml</AllowedOutputExtensionsInSingleFileSelfExtract>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Build artifacts and source snapshots are never application inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);output\**;release\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(SmokeTest)' != 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Keep Chinese framework messages; English is embedded in the neutral assemblies.
         Set IncludeAllLanguages=true to publish every optional translation. -->
    <SatelliteResourceLanguages Condition="'$(SatelliteResourceLanguages)' == '' and '$(IncludeAllLanguages)' != 'true'">zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(SmokeTest)' != 'true'">
    <Compile Remove="NativeBackendSmoke.cs" />
  </ItemGroup>

  <!--
    mobile/ 是独立的手机端工程，不属于桌面端编译范围。
    SDK 默认的 **/*.cs 通配符会把它一起编进来，而
    mobile/android/Backend/ 下的 ArtifactTools、JmImageDecoder
    与 NativeBackend/ 下的同名类同命名空间，会触发 CS0111 重复定义。
  -->
  <ItemGroup>
    <Compile Remove="mobile\**" />
    <EmbeddedResource Remove="mobile\**" />
    <None Remove="mobile\**" />
    <Page Remove="mobile\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\desktop-brand\*.png" />
    <EmbeddedResource Include="docs\THIRD_PARTY_NOTICES.txt" LogicalName="THIRD_PARTY_NOTICES.txt" />
    <!-- Match URL paths on Windows too: RecursiveDir uses backslashes there. -->
    <EmbeddedResource Include="frontend\**\*.*"
                      LogicalName="$([System.String]::Copy('frontend/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))" />
  </ItemGroup>

  <!-- NuGet may ship native .pdb files even when DebugSymbols=false.
       Filter only debug symbols; every managed/native runtime dependency stays in the bundle. -->
  <Target Name="ExcludePublishDebugSymbols" AfterTargets="ComputeFilesToPublish"
          Condition="'$(Configuration)' == 'Release' and '$(SmokeTest)' != 'true'">
    <ItemGroup>
      <PublishDebugSymbols Include="@(ResolvedFileToPublish)"
                           Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(PublishDebugSymbols)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveDevelopmentArtifactsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedXmlDocs Include="$(PublishDir)*.xml" />
      <!-- Also clean top-level symbols left by a previous publish into the same directory. -->
      <StalePublishedDebugSymbols Include="$(PublishDir)*.pdb"
                                 Condition="'$(Configuration)' == 'Release' and '$(SmokeTest)' != 'true'" />
    </ItemGroup>
    <Delete Files="@(PublishedXmlDocs);@(StalePublishedDebugSymbols)" />
  </Target>

  <!--
    WebView2 Evergreen Runtime is supplied by Windows and stays outside the
    single-file package. Only the small SDK bridge/loader required by the WPF
    host is published with the application.
  -->
  <Target Name="ExcludeWebView2BrowserRuntime" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <WebView2BrowserRuntime Include="@(ResolvedFileToPublish)"
                              Condition="'%(ResolvedFileToPublish.Filename)' == 'msedgewebview2'
                                      Or '%(ResolvedFileToPublish.Filename)' == 'EmbeddedBrowserWebView'
                                      Or '%(ResolvedFileToPublish.Filename)' == 'msedge'
                                      Or '%(ResolvedFileToPublish.Filename)' == 'msedge_elf'" />
      <ResolvedFileToPublish Remove="@(WebView2BrowserRuntime)" />
    </ItemGroup>
  </Target>

</Project>
